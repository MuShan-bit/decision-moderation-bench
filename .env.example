# Aliyun Model Studio (DashScope) credentials
DASHSCOPE_API_KEY=sk-xxxxxxxx
# 决策模型（预览版）需要业务空间专属域名；在百炼控制台「业务空间详情」查看 WorkspaceId
SYSTEMONE_WORKSPACE_ID=llm-xxxxxxxxxxxxxxxx
SYSTEMONE_REGION=cn-beijing
MODERATION_PROVIDER=dashscope
MODERATION_MODEL=decision-model-preview
# 本 Key 仅授权决策模型（System One 协议），可选模型列表
MODERATION_MODELS=decision-model-preview
# Optional: providers = dashscope | bamboonode | jev | cloudflare | mock
# PORT=8788

# ---- BambooNode 网关：Jev / StartLux 决策模型（System One typed-decision 协议）----
BAMBOONODE_BASE_URL=https://api.bamboonode.dev/v1
# 网关 Key；留空则 bamboonode provider 不可用
BAMBOONODE_API_KEY=sk-xxxxxxxx
# 可选模型（网关 /api/pricing 可见）：typesafe/jev-1.13, typesafe/jev-1.14,
# startlux-decision-27b-autothink
BAMBOONODE_MODELS=startlux-decision-27b-autothink

# ---- Jev / TypeSafe 官方网关（System One，https://api.typesafe.ai/v1/systemone）----
JEVMODEL_BASE_URL=https://api.typesafe.ai/v1
# 填入有效的 Jev / TypeSafe 网关 API Key；留空则 jev provider 不可用
JEVMODEL_API_KEY=jev_xxxxxxxx
JEVMODEL_MODELS=jev-preview,jev-latest

# ---- Cloudflare Workers AI：clef-omni（System One typed-decision 协议）----
# 文档：https://developers.cloudflare.com/workers-ai/models/clef-omni/
# Token 需要 Workers AI - Read/Edit 权限；Account ID 在 Cloudflare 控制台 Workers AI 页面获取
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=cf_xxxxxxxx
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
CLOUDFLARE_MODELS=clef-omni

# ---- 可选：数据集档案 ----
# DATASET=text            # 默认：文本评测集（任意 provider）
# DATASET=text-image      # 文本图像评测集（仅 cloudflare clef-omni；图片自动取 data/images/）
# DATASET=unsafebench     # UnsafeBench 二分类图像集（需先本地导入 data/real-images/unsafebench/；仅 clef-omni）
# DATASET=nsfw-image      # NSFW 实拍图像（需先本地导入 data/real-images/；仅 clef-omni）
# DATASET_PATH 仍可指向任意自定义 jsonl（优先级高于 DATASET）；IMAGES_DIR 可覆盖图片目录
# DATASET=text-image
# IMAGES_DIR=data/images
