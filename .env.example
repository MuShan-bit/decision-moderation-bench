# Aliyun Model Studio (DashScope) credentials
DASHSCOPE_API_KEY=sk-xxxxxxxx
# 决策模型（预览版）需要业务空间专属域名；在百炼控制台「业务空间详情」查看 WorkspaceId
SYSTEMONE_WORKSPACE_ID=llm-xxxxxxxxxxxxxxxx
SYSTEMONE_REGION=cn-beijing
MODERATION_PROVIDER=systemone
MODERATION_MODEL=decision-model-preview
# 本 Key 仅授权决策模型（systemone 协议），可选模型列表
MODERATION_MODELS=decision-model-preview
# Optional: providers = systemone | mock
# PORT=8788

# ---- BambooNode 网关：Jev / StartLux 决策模型（systemone typed-decision 协议）----
BAMBOONODE_BASE_URL=https://api.bamboonode.dev/v1
# 网关 Key；留空则 bamboonode provider 不可用
BAMBOONODE_API_KEY=sk-xxxxxxxx
# 可选模型（网关 /api/pricing 可见）：typesafe/jev-1.13, typesafe/jev-1.14,
# startlux-decision-27b-autothink
BAMBOONODE_MODELS=startlux-decision-27b-autothink

# ---- Jev 官方网关（TypeSafe System One，https://jevmodel.org/v1/systemone）----
JEVMODEL_BASE_URL=https://jevmodel.org/v1
# 在 https://jevmodel.org/dashboard/ 创建 API Key 后填入；留空则 jev provider 不可用
JEVMODEL_API_KEY=jev_xxxxxxxx
JEVMODEL_MODELS=jev-preview,jev-latest
